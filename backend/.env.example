# Backend environment variables — copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# Express
PORT=3001

# Supabase (get from Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Gemini AI (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# CORS — set to your Vercel frontend URL in production (e.g. https://your-app.vercel.app)
# Leave blank for local development (defaults to http://localhost:5175)
FRONTEND_URL=

# Deployment
NODE_ENV=development
